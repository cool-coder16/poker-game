// Copy of the Firestore security rules published in the Firebase console
// (Firestore Database -> Rules). Keep this file in sync if you change them there.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own profile: users/<their uid>
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Username -> email lookup, so people can sign in with a username.
    // "get" (one document, you must know the name) is public; "list" is NOT allowed,
    // so nobody can download the whole table. Entries are create-only: never edited or deleted.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
    }
    // Weekly leaderboard: seasons/<2026-W45>/players/<uid>. Anyone can read the board; you can
    // only write your own line, and the name on it must be the username saved on your profile
    // (so nobody can post under someone else's name).
    match /seasons/{season}/players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && season.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['username', 'score', 'runs', 'hands', 'wins', 'bb', 'updatedAt'])
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.get('username', null);
    }
    // All-time board: ratings/<uid> holds your rating points and your best run ever. Same idea.
    match /ratings/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'points', 'seasons', 'high', 'updatedAt'])
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.get('username', null);
    }
    // Everything else is denied by default.
  }
}
