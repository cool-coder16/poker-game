// Copy of the Firestore security rules published in the Firebase console
// (Firestore Database -> Rules). Keep this file in sync if you change them there.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own profile: users/<their uid>
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is denied by default.
  }
}
