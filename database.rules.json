{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",

        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          "status": { ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished')" },
          "startChips": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 100000" },
          "sb": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000" },
          "turnSeconds": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120" }
        },

        "seats": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('rooms/' + $code + '/meta/status').val() === 'lobby') || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },

        "bots": { ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid" },
        "state": { ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid" },

        "presence": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        }
      }
    },

    "roomPrivate": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
        }
      }
    },

    "roomActions": {
      "$code": {
        ".read": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/seats/' + $uid).exists()"
        }
      }
    },

    "roomHost": {
      "$code": {
        ".read": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
        ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
      }
    }
  }
}
